# Ocultar archivos y directorios sensibles
<FilesMatch "(?i)(^\.env(?:\.|$)|^env(?:\.example)?\.php$|\.(?:sql|log|ini|bak|backup|local_backup)(?:\.(?:gz|zip))?$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Ocultar acceso al directorio .git/
RedirectMatch 404 /\.git

# Forzar codificación UTF-8
AddDefaultCharset UTF-8

# Desactivar el listado de directorios
Options -Indexes

# Enrutar todo a index.php
RewriteEngine On
# Los módulos se incluyen desde PHP; no son páginas públicas.
RewriteRule ^(?:config|core|models|controllers|views|sql|tests)(?:/|$) - [F,L,NC]
# No exponer instaladores y diagnósticos en el sitio público.
RewriteRule ^(?:setup|migrar_gondolas|test_[^/]*|fix_[^/]*|[^/]+_fixed)\.php$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Security Headers (Protección avanzada del lado del cliente)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
